PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<atlas-host>/<database-name>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGINS=https://sales.example.com
TIKTOK_APP_KEY=
TIKTOK_SERVICE_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://polemoniaceous-herb-semiliberally.ngrok-free.dev/api/tiktok/callback
TIKTOK_FRONTEND_REDIRECT_URI=http://localhost:5173/settings/tiktok
TIKTOK_TOKEN_ENCRYPTION_KEY=
TIKTOK_AUTHORIZATION_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_TOKEN_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SETTLEMENT_SYNC_ENABLED=true
TIKTOK_SETTLEMENT_SYNC_INTERVAL_HOURS=1
TIKTOK_ORDER_SYNC_ENABLED=true
TIKTOK_ORDER_SYNC_INTERVAL_MINUTES=5
TIKTOK_PRODUCT_SYNC_ENABLED=true
TIKTOK_PRODUCT_SYNC_INTERVAL_MINUTES=15
TIKTOK_WEBHOOK_URL=https://your-public-backend.example.com/api/tiktok/webhooks

# Customer Service uses separate callbacks; automation is disabled in MongoDB by default.
TIKTOK_CS_WEBHOOK_BASE_URL=https://your-public-backend.example.com/api/tiktok/customer-service/webhooks

# TikTok synchronization performance (no Redis required)
TIKTOK_SYNC_OVERLAP_SECONDS=300
TIKTOK_FINANCE_OVERLAP_DAYS=2
TIKTOK_FINANCE_CACHE_SECONDS=180
TIKTOK_PRODUCT_FULL_REFRESH_HOURS=24
TIKTOK_FINANCE_FULL_REFRESH_DAYS=7
TIKTOK_FINANCE_MAX_RETRIES=10
